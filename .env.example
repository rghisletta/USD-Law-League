# Copy this file to .env (it's gitignored) and fill in LEAGUE_ID.
# LEAGUE_ID is the leagueId= number in your ESPN league's URL.
LEAGUE_ID=
SEASON=2026
# Your teamId (the teamId= number on your team page); the dashboard opens on it.
MY_TEAM_ID=
# Only needed if the league is private. From a browser logged in to ESPN:
#   DevTools > Application > Cookies > https://fantasy.espn.com
ESPN_S2=
ESPN_SWID=
